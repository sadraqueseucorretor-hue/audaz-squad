# Copie para .env e ajuste. NENHUM token do Bora Vender entra aqui: o token é
# obtido em runtime (login automático) ou colado na área admin, e guardado no
# Postgres. Aqui só entram as CREDENCIAIS de login para a renovação automática.

# --- Banco de dados ---
DATABASE_URL=postgresql+asyncpg://audaz:audaz@db:5432/audaz

# --- Autenticação da aplicação (JWT próprio) ---
# Gere um segredo forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=720

# --- Admin inicial (criado no primeiro start se não houver nenhum usuário) ---
ADMIN_EMAIL=admin@audazsquad.com
ADMIN_SENHA=troque-esta-senha

# --- Integração Bora Vender (Direcional) ---
BORA_VENDER_BASE_URL=https://be.direcional.com.br/bora-vender/v1
REGIONAL=CE
HTTP_TIMEOUT_SEGUNDOS=30
# Unidades de negócio consultadas na listagem (a Riva é separada da Direcional).
# Se faltar alguma marca na disponibilidade, acrescente o nome exato aqui.
UNIDADES_DE_NEGOCIO=["Direcional","Riva"]

# --- Renovação automática do token do Bora Vender ---
# Preencha com o login da Direcional para o servidor renovar o token sozinho
# antes de expirar. Deixe em branco para desligar (aí o token é só manual).
BORA_VENDER_EMAIL=
BORA_VENDER_SENHA=
# Normalmente não precisa mexer no resto:
# BORA_VENDER_LOGIN_URL=https://be.direcional.com.br/bora-vender/v1/autenticacao/login
# BORA_VENDER_CLIENT_ID=b53793b2-7c67-42f4-ac30-06f3a6295179
# BORA_VENDER_ORIGIN=https://boravender.app.br
# BORA_VENDER_TOKEN_CAMPO=authenticationResult.idToken
# RENOVACAO_AUTOMATICA=true
# RENOVAR_ANTES_SEGUNDOS=300
# INTERVALO_RENOVACAO_SEGUNDOS=60

# --- Frontend ---
# Origens liberadas no CORS (dev do Vite). Em produção, o domínio do site.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Pasta do build do frontend a servir enquanto não há nginx. Vazio = não servir.
# No container, o compose monta o build em /frontend/dist.
DIRETORIO_ESTATICOS=
