# Copie para .env e ajuste. NENHUM token do Bora Vender entra aqui:
# ele é cadastrado em runtime pela área admin e guardado no Postgres.

# --- Banco de dados ---
DATABASE_URL=postgresql+asyncpg://audaz:audaz@db:5432/audaz

# --- Autenticação da aplicação (JWT próprio) ---
# Gere um segredo forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=720

# --- Admin inicial (criado no primeiro start se não houver nenhum usuário) ---
ADMIN_EMAIL=admin@audazsquad.com
ADMIN_SENHA=troque-esta-senha

# --- Integração Bora Vender (Direcional) ---
BORA_VENDER_BASE_URL=https://be.direcional.com.br/bora-vender/v1
UNIDADE_DE_NEGOCIO=Direcional
REGIONAL=CE
HTTP_TIMEOUT_SEGUNDOS=30

# --- Frontend ---
# Origens liberadas no CORS (dev do Vite). Em produção, o domínio do site.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Pasta do build do frontend a servir enquanto não há nginx. Vazio = não servir.
# No container, o compose monta o build em /frontend/dist.
DIRETORIO_ESTATICOS=
