# Variáveis do docker-compose (copie para .env na raiz do monorepo).
# O compose injeta DATABASE_URL e DIRETORIO_ESTATICOS automaticamente.

# --- Postgres ---
POSTGRES_USER=audaz
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=audaz

# --- Autenticação da aplicação (JWT próprio) ---
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITMO=HS256
JWT_EXPIRA_MINUTOS=720

# --- Admin inicial (criado no primeiro start) ---
ADMIN_EMAIL=admin@audazsquad.com
ADMIN_SENHA=troque-esta-senha

# --- Integração Bora Vender ---
BORA_VENDER_BASE_URL=https://be.direcional.com.br/bora-vender/v1
UNIDADE_DE_NEGOCIO=Direcional
REGIONAL=CE
HTTP_TIMEOUT_SEGUNDOS=30

# --- CORS (domínio do frontend em produção; em dev, o Vite) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
