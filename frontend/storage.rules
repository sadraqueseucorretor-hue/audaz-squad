rules_version = '2';
// Cole no Firebase Console → Storage → Regras → Publicar.
// Arquivos públicos para leitura; envio só pelo e-mail admin, até 100 MB por arquivo.
service firebase.storage {
  match /b/{bucket}/o {
    match /{caminho=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['sadraqueseucorretor@gmail.com']
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }
  }
}
